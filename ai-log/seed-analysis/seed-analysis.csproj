<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately outside backend/, so backend's Directory.Build.props and `dotnet build` at the
       solution root never pick it up. This is analysis, not shipped code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
