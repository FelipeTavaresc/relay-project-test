{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    // Deliberately empty here: no connection string, and therefore no credentials, in the
    // base settings file. Supplied by appsettings.Development.json locally and by the
    // Database__ConnectionString environment variable in Docker Compose. Startup fails fast
    // if neither provides one.
    "ConnectionString": ""
  },
  "Frontend": {
    // The origin the SPA is served from, allowlisted for CORS. The Angular dev server default;
    // Docker Compose overrides it with Frontend__AllowedOrigins__0 where the web container differs.
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
