<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Swagger reads the XML comments on the controller and the DTOs, so the contract the Angular
         feature is written against is self-describing. CS1591 is off because documenting every
         record positional parameter for its own sake is noise, not documentation. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Relay.Application\Relay.Application.csproj" />
    <!-- Composition only: Program.cs binds IActivityQueries to its EF Core implementation. -->
    <ProjectReference Include="..\Relay.Infrastructure\Relay.Infrastructure.csproj" />
  </ItemGroup>

</Project>
