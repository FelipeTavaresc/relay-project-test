<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- xUnit with its built-in asserts, no fluent-assertion library: FluentAssertions 8.x
       is no longer free for commercial use and 7.x is frozen. csharp-dotnet.md allows
       "plain asserts, consistently", so that is the repo-wide choice. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Relay.Application\Relay.Application.csproj" />
    <!-- The boundary mapping (domain records -> wire contract) is unit-testable on its own; this
         reference is for that, not for spinning up a host. There are no integration tests, by
         decision recorded in techspec § Standards Compliance. -->
    <ProjectReference Include="..\..\src\Relay.Api\Relay.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures/*.csv" />
  </ItemGroup>

</Project>
